<div class="simple-html-editor wmd-editor" id="wmdEditor{{editorIndex}}" data-wmd-mode="visual">
  <div class="simple-html-toolbar wmd-toolbar" role="toolbar" aria-label="Formatting">
    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="bold" data-wmd-state="bold" aria-pressed="false" aria-label="Bold (Ctrl+B)" title="Bold (Ctrl+B)"><span class="simple-html-label" style="font-weight:700">B</span></button>
    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="italic" data-wmd-state="italic" aria-pressed="false" aria-label="Italic (Ctrl+I)" title="Italic (Ctrl+I)"><span class="simple-html-label" style="font-style:italic;font-family:'Lora',serif">I</span></button>
    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="strikethrough" data-wmd-state="strikethrough" aria-pressed="false" aria-label="Strikethrough (Ctrl+Shift+X)" title="Strikethrough (Ctrl+Shift+X)"><span class="simple-html-label" style="text-decoration:line-through">S</span></button>
    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="code" data-wmd-state="code" aria-pressed="false" aria-label="Inline code (Ctrl+E)" title="Inline code (Ctrl+E)"><span class="simple-html-label" style="font-family:monospace">&lt;/&gt;</span></button>

    <span class="simple-html-separator" aria-hidden="true"></span>

    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="heading" data-wmd-level="1" data-wmd-state="h1" aria-pressed="false" aria-label="Heading 1 (Ctrl+Alt+1)" title="Heading 1 (Ctrl+Alt+1)"><span class="simple-html-label">H1</span></button>
    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="heading" data-wmd-level="2" data-wmd-state="h2" aria-pressed="false" aria-label="Heading 2 (Ctrl+Alt+2)" title="Heading 2 (Ctrl+Alt+2)"><span class="simple-html-label">H2</span></button>
    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="heading" data-wmd-level="3" data-wmd-state="h3" aria-pressed="false" aria-label="Heading 3 (Ctrl+Alt+3)" title="Heading 3 (Ctrl+Alt+3)"><span class="simple-html-label">H3</span></button>
    <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-action="heading" data-wmd-level="4" data-wmd-state="h4" aria-pressed="false" aria-label="Heading 4 (Ctrl+Alt+4)" title="Heading 4 (Ctrl+Alt+4)"><span class="simple-html-label">H4</span></button>

    <span class="simple-html-separator" aria-hidden="true"></span>

    <button type="button" class="simple-html-button" data-wmd-action="bullet-list" data-wmd-state="insertUnorderedList" aria-pressed="false" aria-label="Bullet list (Ctrl+Shift+8)" title="Bullet list (Ctrl+Shift+8)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="numbered-list" data-wmd-state="insertOrderedList" aria-pressed="false" aria-label="Numbered list (Ctrl+Shift+7)" title="Numbered list (Ctrl+Shift+7)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="10" y1="6" x2="20" y2="6"/><line x1="10" y1="12" x2="20" y2="12"/><line x1="10" y1="18" x2="20" y2="18"/><text x="2" y="8" font-size="7" fill="currentColor" stroke="none" font-family="monospace">1.</text><text x="2" y="14" font-size="7" fill="currentColor" stroke="none" font-family="monospace">2.</text><text x="2" y="20" font-size="7" fill="currentColor" stroke="none" font-family="monospace">3.</text></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="quote" data-wmd-state="blockquote" aria-pressed="false" aria-label="Block quote (Ctrl+Shift+9)" title="Block quote (Ctrl+Shift+9)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="code-block" data-wmd-state="pre" aria-pressed="false" aria-label="Code block" title="Code block">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="8 7 3 12 8 17"/><polyline points="16 7 21 12 16 17"/><line x1="14" y1="4" x2="10" y2="20"/></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="hr" aria-label="Horizontal rule" title="Horizontal rule">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12" stroke-width="2.5"/><line x1="3" y1="6" x2="6" y2="6" stroke-width="1.5" opacity="0.4"/><line x1="18" y1="6" x2="21" y2="6" stroke-width="1.5" opacity="0.4"/><line x1="3" y1="18" x2="6" y2="18" stroke-width="1.5" opacity="0.4"/><line x1="18" y1="18" x2="21" y2="18" stroke-width="1.5" opacity="0.4"/></svg>
    </button>

    <span class="simple-html-separator" aria-hidden="true"></span>

    <button type="button" class="simple-html-button" data-wmd-action="link" data-wmd-state="link" aria-pressed="false" aria-label="Insert or edit link (Ctrl+K)" title="Insert or edit link (Ctrl+K)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="table" aria-label="Insert table" title="Insert table">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="1.5"/><line x1="3" y1="9.5" x2="21" y2="9.5"/><line x1="3" y1="14.75" x2="21" y2="14.75"/><line x1="9" y1="4" x2="9" y2="20"/><line x1="15" y1="4" x2="15" y2="20"/></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="image-url" aria-label="Insert image from URL" title="Insert image from URL">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="image-upload" aria-label="Upload image" title="Upload image">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg>
    </button>

    <span class="simple-html-separator" aria-hidden="true"></span>

    <button type="button" class="simple-html-button" data-wmd-action="undo" aria-label="Undo (Ctrl+Z)" title="Undo (Ctrl+Z)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
    </button>
    <button type="button" class="simple-html-button" data-wmd-action="redo" aria-label="Redo (Ctrl+Y)" title="Redo (Ctrl+Y)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 14 20 9 15 4"/><path d="M4 20v-7a4 4 0 0 1 4-4h12"/></svg>
    </button>

    <span class="wmd-mode-group" role="group" aria-label="View">
      <button type="button" class="simple-html-button simple-html-button-wide active" data-wmd-mode="visual" aria-pressed="true" title="Edit visually"><span class="simple-html-label">Visual</span></button>
      <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-mode="source" aria-pressed="false" title="Edit the Markdown source"><span class="simple-html-label">Source</span></button>
      <button type="button" class="simple-html-button simple-html-button-wide" data-wmd-mode="split" aria-pressed="false" title="Source and visual side by side"><span class="simple-html-label">Split</span></button>
    </span>
    <input type="file" class="wmd-file-input" accept="image/*" style="display:none" tabindex="-1" aria-hidden="true" />
  </div>

  <div class="wmd-table-bar" role="toolbar" aria-label="Table" hidden>
    <span class="wmd-table-bar-label">Table</span>
    <button type="button" class="simple-html-button" data-wmd-table="add-row">Add row</button>
    <button type="button" class="simple-html-button" data-wmd-table="add-column">Add column</button>
    <button type="button" class="simple-html-button secondary" data-wmd-table="delete-row">Delete row</button>
    <button type="button" class="simple-html-button secondary" data-wmd-table="delete-column">Delete column</button>
    <button type="button" class="simple-html-button secondary" data-wmd-table="delete-table">Delete table</button>
  </div>

  <div class="wmd-panes">
    <div class="wmd-source-pane">
      <div id="editor{{editorIndex}}Source" class="wmd-source-host"></div>
    </div>
    <div class="wmd-visual-pane">
      <div class="simple-html-surface wmd-surface" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Markdown document" data-placeholder="Begin writing…" spellcheck="true"></div>
    </div>
  </div>

  <div class="wmd-status" aria-live="polite"></div>

  <div class="wmd-dialog-backdrop" hidden>
    <form class="wmd-dialog" role="dialog" aria-modal="true">
      <h3 class="wmd-dialog-title"></h3>
      <div class="wmd-dialog-fields"></div>
      <div class="wmd-dialog-actions">
        <button type="button" class="simple-html-button secondary wmd-dialog-remove" hidden>Remove</button>
        <span class="wmd-dialog-spacer"></span>
        <button type="button" class="simple-html-button secondary wmd-dialog-cancel">Cancel</button>
        <button type="submit" class="simple-html-button wmd-dialog-ok">OK</button>
      </div>
    </form>
  </div>
</div>
