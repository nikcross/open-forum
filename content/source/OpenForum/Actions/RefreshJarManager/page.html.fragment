<p>Refreshes the JAR manager to reload Java libraries</p>

<b>Get parameters</b>
<ul><li> pageName = Any page name (required but not used)</li>
</ul>
<b>Get examples:</b>
<xmp class="panel" of-exclude="true">
// Simple URL
/OpenForum/Actions/RefreshJarManager?pageName=dummy

// Using JSON.get
JSON.get('/OpenForum/Actions/RefreshJarManager', null, 'pageName=dummy')
  .onSuccess(function(result) {
    console.log('JAR manager refreshed:', result);
  }).go();
</xmp>


<b><a href="http://open-forum.onestonesoup.org/OpenForum/Documentation/Reference/UsingWikiActions" target="external_page">Get Action</a></b> 

<a href="/OpenForum/Actions/RefreshJarManager?pageName=dummy">/OpenForum/Actions/RefreshJarManager?pageName=dummy</a>

<hr/>
<h3>Server Side Javascript for GET method</h3>
<xmp class="panel" of-exclude="true"> if(typeof(pageName)=="undefined")
{
	transaction.setResult(transaction.SHOW_PAGE);
}
else
{
  js.refreshJarManager();

  transaction.sendPage("OK");
} </xmp>