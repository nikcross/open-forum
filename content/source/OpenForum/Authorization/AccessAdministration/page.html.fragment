<!--Content built using /OpenForum/Javascript/PageBuilder/default-page.builder.js 0.0.7 Gloomy November builder and renderer DefaultRenderer v1.08 2021 Covid release-->
<div style="display: none" id="content">
  <div class="row">
    <h2>Page {{pageName}} <!--Extension ActionButton text="Save Changes" action="saveChanges" --><a  class='button radius tiny' href='#' onclick='saveChanges(); return false;'>Save Changes</a> <!--End Extension ActionButton text="Save Changes" action="saveChanges" --></h2>
  </div>
  <div>
    <div class="large-3 columns">
      <h3>Read Access</h3>
      <table style="width: 100%; height: 40%">
        <tr><td>User</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="user in accessView.readAccess.users">
          <td>{{user}}</td>
          <td>
            <!--Extension ActionButton text="Remove User" action="removeUser" parameters="{{user}},read" --><a  class='button radius tiny' href='#' onclick='removeUser("{{user}}","read"); return false;'>Remove User</a> <!--End Extension ActionButton text="Remove User" action="removeUser" parameters="{{user}},read" -->
          </td>
        </tr>
      </table>
        
      <table style="width: 100%; height: 40%">
        <tr><td>Group</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="group in accessView.readAccess.groups">
          <td>{{group}}</td>
          <td>
            <!--Extension ActionButton text="Remove User" action="removeGroup" parameters="{{group}},read" --><a  class='button radius tiny' href='#' onclick='removeGroup("{{group}}","read"); return false;'>Remove User</a> <!--End Extension ActionButton text="Remove User" action="removeGroup" parameters="{{group}},read" -->
          </td>
        </tr>
      </table>
    </div>
    <div class="large-3 columns">
      <h3>Call Access</h3>
      <table style="width: 100%; height: 40%">
        <tr><td>User</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="user in accessView.callAccess.users">
          <td>{{user}}</td>
          <td>
            <!--Extension ActionButton text="Remove User" action="removeUser" parameters="{{user}},call" --><a  class='button radius tiny' href='#' onclick='removeUser("{{user}}","call"); return false;'>Remove User</a> <!--End Extension ActionButton text="Remove User" action="removeUser" parameters="{{user}},call" -->
          </td>
        </tr>
      </table>
      
      <table style="width: 100%; height: 40%">
        <tr><td>Group</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="group in accessView.callAccess.groups">
          <td>{{group}}</td>
          <td>
            <!--Extension ActionButton text="Remove User" action="removeGroup" parameters="{{group}},call" --><a  class='button radius tiny' href='#' onclick='removeGroup("{{group}}","call"); return false;'>Remove User</a> <!--End Extension ActionButton text="Remove User" action="removeGroup" parameters="{{group}},call" -->
          </td>
        </tr>
      </table>
    </div>
    <div class="large-3 columns">
      <h3>Update Access</h3>
      <table style="width: 100%; height: 40%">
        <tr><td>User</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="user in accessView.updateAccess.users">
          <td>{{user}}</td>
          <td>
            <!--Extension ActionButton text="Remove User" action="removeUser" parameters="{{user}},update" --><a  class='button radius tiny' href='#' onclick='removeUser("{{user}}","update"); return false;'>Remove User</a> <!--End Extension ActionButton text="Remove User" action="removeUser" parameters="{{user}},update" -->
          </td>
        </tr>
      </table>
      <table style="width: 100%; height: 40%">
        <tr><td>Group</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="group in accessView.updateAccess.groups">
          <td>{{group}}</td>
          <td>
            <!--Extension ActionButton text="Remove Group" action="removeGroup" parameters="{{group}},update" --><a  class='button radius tiny' href='#' onclick='removeGroup("{{group}}","update"); return false;'>Remove Group</a> <!--End Extension ActionButton text="Remove Group" action="removeGroup" parameters="{{group}},update" -->
          </td>
        </tr>
      </table>
    </div>
    <div class="large-3 columns">
      <h3>Delete Access</h3>
      <table style="width: 100%; height: 40%">
        <tr><td>User</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="user in accessView.deleteAccess.users">
          <td>{{user}}</td>
          <td>
            <!--Extension ActionButton text="Remove Group" action="removeUser" parameters="{{user}},delete" --><a  class='button radius tiny' href='#' onclick='removeUser("{{user}}","delete"); return false;'>Remove Group</a> <!--End Extension ActionButton text="Remove Group" action="removeUser" parameters="{{user}},delete" -->
          </td>
        </tr>
      </table>
      <table style="width: 100%; height: 40%">
        <tr><td>Group</td><td>&nbsp;</td></tr>
        <tr of-repeatFor="group in accessView.deleteAccess.groups">
          <td>{{group}}</td>
          <td>
            <!--Extension ActionButton text="Remove Group" action="removeGroup" parameters="{{group}},delete" --><a  class='button radius tiny' href='#' onclick='removeGroup("{{group}}","delete"); return false;'>Remove Group</a> <!--End Extension ActionButton text="Remove Group" action="removeGroup" parameters="{{group}},delete" -->
          </td>
        </tr>
      </table>
    </div>
  </div>
  <div class="row">
    <!--Extension ActionButton text="Change User Access Rights" action="editUser" --><a  class='button radius tiny' href='#' onclick='editUser(); return false;'>Change User Access Rights</a> <!--End Extension ActionButton text="Change User Access Rights" action="editUser" -->
    <!--Extension ActionButton text="Change Group Access Rights" action="editGroup" --><a  class='button radius tiny' href='#' onclick='editGroup(); return false;'>Change Group Access Rights</a> <!--End Extension ActionButton text="Change Group Access Rights" action="editGroup" -->

    <form id="editForm" style="display: none;">
      <fieldset>
        <legend>Edit {{editingUser}}{{editingGroup}} Access</legend>
        <div class='row' id="selectUser" style="display: none;">
          <div class='large-12 columns'>
            <label>User Name <select of-id="editingUser"><option of-repeatFor="user in users">{{user}}</option></select></label>
          </div>
        </div>
        <div class='row' id="selectGroup" style="display: none;">
          <div class='large-12 columns'>
            <label>Group Name <select of-id="editingGroup"><option of-repeatFor="group in groups">{{group}}</option></select></label>
          </div>
        </div>
        <div class='row'>
          <div class='large-3 columns'>

            <label for="readAccessCheckBox">Read</label>
            <div class="switch">
              <input of-id="readAccessCheckBox" id="readAccessCheckBox" type="checkbox">
              <label for="readAccessCheckBox"></label>
            </div>

          </div>
        <div class='large-3 columns'>

            <label for="callAccessCheckBox">Call</label>
            <div class="switch">
              <input of-id="callAccessCheckBox" id="callAccessCheckBox" type="checkbox">
              <label for="callAccessCheckBox"></label>
            </div>

          </div>
          <div class='large-3 columns'>

            <label for="updateAccessCheckBox">Update</label>
            <div class="switch">
              <input of-id="updateAccessCheckBox" id="updateAccessCheckBox" type="checkbox">
              <label for="updateAccessCheckBox"></label>
            </div>

          </div>
          <div class='large-3 columns'>

            <label for="deleteAccessCheckBox">Delete</label>
            <div class="switch">
              <input of-id="deleteAccessCheckBox" id="deleteAccessCheckBox" type="checkbox">
              <label for="deleteAccessCheckBox"></label>
            </div>

          </div>
        </div>
        <div class='row'>
          <div class='large-12 columns'>
            <!--Extension ActionButton text="Update" action="updateFromForm" --><a  class='button radius tiny' href='#' onclick='updateFromForm(); return false;'>Update</a> <!--End Extension ActionButton text="Update" action="updateFromForm" -->
          </div>
        </div>
      </fieldset>
    </form>

  </div>
</div>

<a href="/OpenForum/Spider?config=/OpenForum/Authorization/AccessAdministration/spider.config.json&run=true" target="spider">Generate Access Report</a>