<!--Content built using /OpenForum/Javascript/PageBuilder/default-page.builder.js 0.0.7 Gloomy November builder and renderer DefaultRenderer v1.08 2021 Covid release-->
<h2>Moved to <a href="/OpenForum/AddOn/ServiceBuilder">/OpenForum/AddOn/ServiceBuilder</a></h2>

<!--OF insert (/OpenForum/Javascript/Builder/build-client.content) start --><!--Extension Button title="Major Version ++" function="incrementMajorVersion" --><a class="button tiny" onClick="incrementMajorVersion(); return false;">Major Version ++</a><!--End Extension Button title="Major Version ++" function="incrementMajorVersion" --><!--Extension Button title="Minor Version ++" function="incrementMinorVersion" --><a class="button tiny" onClick="incrementMinorVersion(); return false;">Minor Version ++</a><!--End Extension Button title="Minor Version ++" function="incrementMinorVersion" --><!--Extension Button title="Build Version ++" function="incrementBuildVersion" --><a class="button tiny" onClick="incrementBuildVersion(); return false;">Build Version ++</a><!--End Extension Button title="Build Version ++" function="incrementBuildVersion" -->
<ul><li>Version: <b>{{buildScript.version}}</b></li>
<li>Target File: <b>{{buildScript.targetFile}}</b></li>
<li>Version File: <b>{{buildScript.versionFile}}</b></li>
</ul>
<ol>
  <li of-repeatFor="step in buildScript.steps">
    {{step.action}} 
    {{ if(step.file) "File:"+step.file; else ""; }}
    {{  if(step.searchFor) "Search for " + step.searchFor + " and replace with " + step.replaceWith; else ""; }}
  </li>
</ol>

<!--Extension Button title="Build" function="runBuildScript" --><a class="button tiny" onClick="runBuildScript(); return false;">Build</a><!--End Extension Button title="Build" function="runBuildScript" -->

<hr/>

<h3>Output</h3>

<xmp>
  {{buildScript.script}}
</xmp>

<hr/>

 <h3>Versions</h3>

 <!--Extension AttachmentsList pageName="/OpenForum/Javascript/Builder/Versions" matching=".js" --><!--End Extension AttachmentsList pageName="/OpenForum/Javascript/Builder/Versions" matching=".js" -->

<div id="statusModal" class="reveal-modal" data-reveal aria-labelledby="modalTitle" aria-hidden="true" role="dialog">
  <h2 id="modalTitle">{{popupStatus}}</h2>
  <a class="close-reveal-modal" aria-label="Close">&#215;</a>
</div>

<!--Extension Popup id="statusModal" title="{{popupStatus}}" content="" --><div id="statusModal" class="reveal-modal" data-reveal aria-labelledby="statusModalModalTitle" aria-hidden="true" role="dialog">  <a class="close-reveal-modal" aria-label="Close">&#215;</a></div><!--End Extension Popup id="statusModal" title="{{popupStatus}}" content="" -->

<!--Extension Popup id="buildScriptModal" title="Build Script" sourceFileName="build-script-form.wiki" sourcePageName="/OpenForum/Javascript/Builder" --><div id="buildScriptModal" class="reveal-modal" data-reveal aria-labelledby="buildScriptModalModalTitle" aria-hidden="true" role="dialog"><form>
  <div class='row'>
    <div class='large-6 columns'>
      <label>Target File</label><input type='text' of-id='buildScript.targetFile' value='{{buildScript.targetFile}}' placeholder='target file to be built' />
    </div>
    <div class='large-6 columns'>
      <label>Version File</label><input type='text' of-id='buildScript.versionFile' value='{{buildScript.versionFile}}' placeholder='location and name of versioned file' />
    </div>
  </div>
  <div class='row'>
    <div class='large-12 columns'>
      <h3>Build Steps</h3>
      <table>
        <thead>
        <tr>
          <td>Action</td><td>FileName</td>
        </tr>
        </thead>
        <tbody>
        <tr of-repeatFor="step in buildScript.steps">
         	<td>{{step.action}}</td><td>{{step.fileName}}</td>
        </tr>
        </tbody>
      </table>
    </div>
  </div>
  <div class='row'>
    <div class='large-12 columns'>
      <label>Source File</label><input type='text' of-id='buildScriptNewSourceFile' placeholder='source file to be applended' /> <!--Extension Button title="Add" function="addAppendStep" --><a class="button tiny" onClick="addAppendStep(); return false;">Add</a><!--End Extension Button title="Add" function="addAppendStep" -->
    </div>
  </div>
</form>
<!--Extension Button title="Save" function="saveBuildScript" --><a class="button tiny" onClick="saveBuildScript(); return false;">Save</a><!--End Extension Button title="Save" function="saveBuildScript" -->  <a class="close-reveal-modal" aria-label="Close">&#215;</a></div><!--End Extension Popup id="buildScriptModal" title="Build Script" sourceFileName="build-script-form.wiki" sourcePageName="/OpenForum/Javascript/Builder" -->
<!--OF insert (/OpenForum/Javascript/Builder/build-client.content) end -->