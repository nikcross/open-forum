OpenForum.testing.writeToForm = function(data) {
  for(var i in data) {
    try{
      var el = document.getElementById(i);
      if(typeof el == "undefined") {
        el = document.getElementsByName(i)<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/OffSite/0"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/OffSite/0 does not exist. Click to create it.">0</a>;
      }
      if(el.type=="radio") {
        if(data<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/OffSite/i"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/OffSite/i does not exist. Click to create it.">i</a>==true) {
          el.checked=true;
          console.log( i + ".checked = true" );
        } else {
          el.checked=false;
          console.log( i + ".checked = false" );
        }
      } else {
        el.value = data<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/OffSite/i"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/OffSite/i does not exist. Click to create it.">i</a>;
        console.log( i + ".value set to " + el.value );
      }

    } catch(e) {
      console.log("In "+i);
      console.log("Ex:" + e);
    }
  }
};

