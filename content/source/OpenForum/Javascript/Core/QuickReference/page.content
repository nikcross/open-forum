!!OpenForum - Quick Reference

----
!!!Quick Start
!!In page.js
{{{
OpenForum.init() {
}
}}}

!!Include script
{{{
OpenForum.includeScript("");
}}}

!!In page.content
{{{
	Name: {{currentPerson.name}}
}}}
Tables
{{{
	<table>
      <tr of-repeatFor="person in people">
        <td>{{person.name}}</td>
        <td>{{person.age}}</td>
      </tr>
	</table>
}}}
!!Input Fields
{{{
	<input type="text" of-id="currentPerson.name"/>
}}}

!!Watch a variable
{{{
	OpenForum.addListener("currentPerson.name",function(object) { message = "Current Person's Name Changed to " + object.getValue() });
}}}


!!Call a service
{{{
	OFX.get("/PeopleServicePage").withAction("getPeople").onSuccess(
		function(response) {
			people = response.people;
			currentPerson = people[0];
		}
	).go();
}}}

!!Force update
{{{
	OpenForum.scan();
}}}

