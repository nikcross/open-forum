  };

  self.preparePage = function(node) {
    //Copy all attributes starting ofa-??? to attribute ???
    if(node.attributes) {
      for(var i=0;i<node.attributes.length;i++) {
        var key = node.attributes<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Core/i"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Core/i does not exist. Click to create it.">i</a>.name;
