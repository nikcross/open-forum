      if(node.attributes<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Core/a"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Core/a does not exist. Click to create it.">a</a>.value.indexOf(self.FIELD_DELIMETER_START)!==0) continue;
