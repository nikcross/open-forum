      objects<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Core/id"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Core/id does not exist. Click to create it.">id</a> = new OpenForumObject(id);
