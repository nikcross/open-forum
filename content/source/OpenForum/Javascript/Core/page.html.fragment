          else if(Array.isArray(a<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Core/i"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Core/i does not exist. Click to create it.">i</a>)) value = OpenForum.copyDifferencesFromTo(a<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Core/i"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Core/i does not exist. Click to create it.">i</a>,<a href="/OpenForum/Javascript/Core/" target="newTab"><img src='/OpenForum/Images/icons/png/link_go.png' /></a>,depth+1,minDepth,maxDepth,doDelete);
