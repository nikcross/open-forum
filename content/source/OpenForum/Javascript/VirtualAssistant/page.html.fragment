<!--Extension InsertSourceFile soucrePageName="/OpenForum/Javascript/VirtualAssistant" fileName="page.js" --><a href="//OpenForum/Javascript/VirtualAssistant/page.js">//OpenForum/Javascript/VirtualAssistant/page.js</a><a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/VirtualAssistant&fileName=page.js" title="Edit"><img src="/OpenForum/Images/icons/gif/pencil.gif" border="0"></a><xmp class="panel">
