println(file.getClass().getName());

var clas = file.getClass();
var clasJSON = { methods: <a href="/OpenForum/Javascript/JavaWrapper/" target="newTab"><img src='/OpenForum/Images/icons/png/link_go.png' /></a> };
for(var methodI in clas.getDeclaredMethods()) {
  var method = clas.getDeclaredMethods()<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/JavaWrapper/methodI"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/JavaWrapper/methodI does not exist. Click to create it.">methodI</a>;
  println("m:"+method.getName());
  var methodName = method.getName();
  
  var allPrimatives = true;
  var methodJSON = {name: methodName};
  
  for(var argI in method.getParameterTypes()) {
    var arg = method.getParameterTypes()<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/JavaWrapper/argI"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/JavaWrapper/argI does not exist. Click to create it.">argI</a>;
    println(" a:"+arg.getName());
    
    if(arg.getClass().isPrimitive()===false) {
      allPrimatives = false;
      break;
    }
    var argName = arg.getName;
    
    methodJSON.push( {name: 'arg'+argI, type: argName} );
  }
  if(allPrimatives) {
    clasJSON.push(methodJSON);
  }
}

