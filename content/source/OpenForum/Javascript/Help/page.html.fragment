    table<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/i"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/i does not exist. Click to create it.">i</a>.view = "display: block;";
    table<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/i"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/i does not exist. Click to create it.">i</a>.edit = "display: none;";
