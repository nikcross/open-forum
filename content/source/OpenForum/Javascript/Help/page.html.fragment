  } else {
    //Is simple array so value is column
  	table<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/row"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/row does not exist. Click to create it.">row</a> = column;
