    for(var entry in this.data) {
      if(dataString.length>0) {
        dataString +="&";
      }
      dataString += this.data<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/entry"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/entry does not exist. Click to create it.">entry</a><a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/0"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/0 does not exist. Click to create it.">0</a>+"="+encodeURIComponent(this.data<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/entry"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/entry does not exist. Click to create it.">entry</a><a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/1"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/1 does not exist. Click to create it.">1</a>);
    }
    return dataString;
  };
  //TODO add get parameters method like
  <!--
      this.data="";
    for(this.loop=0;this.loop<dataArray.length;this.loop++)
    {
      if(this.loop!=0)
      {
        this.data += "&";
