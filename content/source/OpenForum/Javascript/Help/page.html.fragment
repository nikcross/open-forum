      this.data += dataArray<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/this.loop"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/this.loop does not exist. Click to create it.">this.loop</a><a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/0"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/0 does not exist. Click to create it.">0</a>+"="+encodeURIComponent(dataArray<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/this.loop"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/this.loop does not exist. Click to create it.">this.loop</a><a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/1"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/1 does not exist. Click to create it.">1</a>);
