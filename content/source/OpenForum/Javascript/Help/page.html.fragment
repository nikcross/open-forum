      if(name.length>0) {
        this.addItem(name,form.elements<a href="/OpenForum/Editor?pageName=/OpenForum/Javascript/Help/loop"target="editor" style="color: red" title="The page /OpenForum/Editor?pageName=/OpenForum/Javascript/Help/loop does not exist. Click to create it.">loop</a>.value);
