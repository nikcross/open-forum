<!--Content built using /OpenForum/Javascript/PageBuilder/default-page.builder.js 0.0.7 Gloomy November builder and renderer DefaultRenderer v1.08 2021 Covid release-->
<div class="row">
  <h3>Updater {{VERSION}}</h3>

  <div class="row">
    <label>Parent Host </label><div class="columns large-8">{{host}}</div>
  </div>
  <div class="row">
    <label>Page Name </label><div class="columns large-8"><input type="text" of-id="targetPageName" /></div>
  </div>
  <div class="row">
    <!--Extension Button title="Get Update Info" function="getUpdateInfo" --><a class="button tiny" onClick="getUpdateInfo(); return false;">Get Update Info</a><!--End Extension Button title="Get Update Info" function="getUpdateInfo" -->
    <!--Extension Button title="Get Update" function="getUpdate" --><a class="button tiny" onClick="getUpdate(); return false;">Get Update</a><!--End Extension Button title="Get Update" function="getUpdate" -->
  </div>
  <div class="row"> <ul><li> Page Name: {{release.pagename}}</li>
<li> Version: {{release.version}}</li>
<li> Released: {{release.releaseTime}}</li>
<li> Size: {{release.zipfilesize_VIEW}}</li>
</ul>
    <b>Notes:</b> <div class="panel callout radius"> {{release.extra.extra.notes}} </div> <br/><br/>
    <b>Requires:</b>
    <div class="panel callout radius"> 
    <ul>
      <li of-repeatFor="required in release.extra.requires">{{required.pageName}} version {{required.version}}</li>
    </ul>
   </div> <br/><br/>
  </div>
  <hr/>
  <div class="row">
    Search For <input of-id="rowFilter" type="text"/>
  </div>
  <div class="row">
    <table id="releases">
      <tr of-repeatFor="release in releases">
        <td><a href="#" onClick="targetPageName='{{release.pagename}}'; getUpdateInfo(); return false;">{{release.pagename}}</a></td>
        <td>{{release.version_VIEW}}</td>
        <td>{{release.releaseTime}}</td>
        <td>{{release.zipfilesize_VIEW}}</td>
        <td>{{release.autoUpdate}}</td>
      </tr>
    </table>
  </div>
</div>

  <div class="row">
    <a href="/OpenForum/AddOn/Update/" target="newTab">API Reference<img src='/OpenForum/Images/icons/png/link_go.png' /></a>
  </div>