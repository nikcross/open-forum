<p>A button that fires an <a href="/OpenForum/Actions">OpenForum GET action</a> on the server</p>
<b>Parameters</b>
<ul><li> action = Action Name</li>
<li> text = Action button text</li>
<li> parameters = Optional parameters to pass to the action</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension ServerActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" --><a class="button" href="#" onclick="ajax.doGet('/OpenForum/Actions/Rebuild','pageName=Home');return false;">Rebuild Wiki</a><!--End Extension ServerActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" -->
</xmp>

<!--Extension ActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" --><a  class='button radius tiny' href='#' onclick='Rebuild("pageName=Home"); return false;'>Rebuild Wiki</a> <!--End Extension ActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" -->

<hr/>
<h3>Usage:</h3>
<xmp class="panel" of-exclude="true">
<!--Extension ActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" --><a  class='button radius tiny' href='#' onclick='Rebuild("pageName=Home"); return false;'>Rebuild Wiki</a> <!--End Extension ActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" -->
</xmp>

<hr/>

<!--Extension InsertSourceFile fileName="renderer.sjs" --><a href="//OpenForum/Extensions/ServerActionButton/renderer.sjs">//OpenForum/Extensions/ServerActionButton/renderer.sjs</a><a href="/OpenForum/Editor?pageName=/OpenForum/Extensions/ServerActionButton&fileName=renderer.sjs" title="Edit"><img src="/OpenForum/Images/icons/gif/pencil.gif" border="0"></a><xmp class="panel">action = extension.getAttribute("action");
parameters = extension.getAttribute("parameters");
text = extension.getAttribute("text");

return "<a class=<br/>"button<br/>" href=<br/>"#<br/>" onclick=<br/>"ajax.doGet('/OpenForum/Actions/"+action+"','"+parameters+"');return false;<br/>">"+text+"</a>";
</xmp><!--End Extension InsertSourceFile fileName="renderer.sjs" -->