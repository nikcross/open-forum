<!--Content built using /OpenForum/Javascript/PageBuilder/default-page.builder.js 0.0.7 Gloomy November builder and renderer DefaultRenderer v1.08 2021 Covid release-->
<h3>OpenForum Extended Markup</h3>

<!--Extension ChildrenContentsPage --><div class="row">


<hr/>

 <h3> <a href="/OpenForum/Extensions/ActionButton">ActionButton</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/ActionButton" section="1" -->

<p>A button that fires an <a href="/OpenForum/Actions">OpenForum GET action</a></p>
<b>Parameters</b>
<ul><li> action = Action Name</li>
<li> text = Action button text</li>
<li> parameters = Optional parameters to pass to the action</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension ActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" --><a  class='button radius tiny' href='#' onclick='Rebuild("pageName=Home"); return false;'>Rebuild Wiki</a> <!--End Extension ActionButton action="Rebuild" parameters="pageName=Home" text="Rebuild Wiki" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/ActionButton" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/ActionInput">ActionInput</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/ActionInput" section="1" -->

<p>An input field that fires an <a href="/OpenForum/Actions">OpenForum GET action</a></p>
<b>Parameters</b>
<ul><li> action = Action Name</li>
<li> parameters = Optional parameters to pass to the action</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension ActionInput action="alert" parameters="pageName=Home" --><input type="text" onKeyPress="(function(element,event) { if(event.charCode != 13) {return false;} else { alert( element.value ); } })(this,event);"><!--End Extension ActionInput action="alert" parameters="pageName=Home" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/ActionInput" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/AttachmentsList">AttachmentsList</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/AttachmentsList" section="1" -->

<p>Lists attachments for a page with optional filtering</p>
<b>Parameters</b>
<ul><li> targetPage = Page name to list attachments from (blank for current page)</li>
<li> matching = Filter pattern (e.g., ".txt" for text files)</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension AttachmentsList targetPage="" matching=".txt" --><!--End Extension AttachmentsList targetPage="" matching=".txt" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/AttachmentsList" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/Banner">Banner</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/Banner" section="1" -->

<p>Creates a banner with image, title, and text</p>
<b>Parameters</b>
<ul><li> imageURL = URL of the banner image</li>
<li> title = Banner title</li>
<li> text = Banner text content</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension Banner imageURL="/path/to/image.jpg" title="Welcome" text="Welcome to our site" --><div style="background-repeat: no-repeat;
  background-size: cover;
  background-image: url(/path/to/image.jpg);
  background-color: darkgreen;
  color: white;
  padding: 1em;">  
	<h1 style="color: white !important;">Welcome</h1>
	<p style="width: 40%"><b>Welcome to our site</b></p>
</div><!--End Extension Banner imageURL="/path/to/image.jpg" title="Welcome" text="Welcome to our site" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/Banner" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/Bookmarklet">Bookmarklet</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/Bookmarklet" section="1" -->

<p>Adds a link to automatically bookmark a page</p>
<b>Parameters</b>
<ul><li> title = Bookmark title Name</li>
<li> domain = external site domain</li>
<li> script = Path to script</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension Bookmarklet title="Bookmark" domain="https://open-forum.onestonesoup.org" script="/OpenForum/Extensions/Bookmarklet/append-link.js" text="Bookmark pages more easily. Drag this bookmarklet to the Bookmarks bar of your browser:" -->Bookmark pages more easily. Drag this bookmarklet to the Bookmarks bar of your browser:<a class='button tiny round success' href="javascript: window.open('https://open-forum.onestonesoup.org/OpenForum/Extensions/Bookmarklet?action=appendLink&pageName=/OpenForum/Extensions&url=' + encodeURIComponent(window.location.href),'_blank');">Bookmark</a><!--End Extension Bookmarklet title="Bookmark" domain="https://open-forum.onestonesoup.org" script="/OpenForum/Extensions/Bookmarklet/append-link.js" text="Bookmark pages more easily. Drag this bookmarklet to the Bookmarks bar of your browser:" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/Bookmarklet" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/Button">Button</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/Button" section="1" -->

<p>Deprecated - Use <a href="/OpenForum/Extensions/ActionButton">/OpenForum/Extensions/ActionButton</a> instead</p>
<b>Parameters</b>
<ul><li> title = Button text</li>
<li> function = JavaScript function to call</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension Button title="Do Action" function="doAction" --><a class="button tiny" onClick="doAction(); return false;">Do Action</a><!--End Extension Button title="Do Action" function="doAction" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/Button" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/CTABanner">CTABanner</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/CTABanner" section="1" -->

<p>Creates a call-to-action banner with image, title, text, and button</p>
<b>Parameters</b>
<ul><li> imageURL = URL of the banner image</li>
<li> title = Banner title</li>
<li> text = Description text for the CTA</li>
<li> ctaText = Text for the call-to-action button</li>
<li> ctaURL = URL the button links to</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension CTABanner imageURL="/OpenForum/Images/open-forum-dog-small.png" title="Call To Action" text="A description of the CTA" ctaText="Click Me" ctaURL="http://www.bbc.co.uk" --><script>
  var ctaCSSLoaded = false;
  if(ctaCSSLoaded == false) {
    ctaCSSLoaded= true;
    OpenForum.loadCSS( "/OpenForum/Extensions/CTABanner/cta.css" );
  }
</script>
<div class="ctaBanner" style="background-image: url(/OpenForum/Images/open-forum-dog-small.png);">  
	<h1 style="color: white !important;">Call To Action</h1>
	<p style="width: 40%"><b>A description of the CTA</b></p>
  <a href='http://www.bbc.co.uk' class='ctaButton'>Click Me</a>
</div><!--End Extension CTABanner imageURL="/OpenForum/Images/open-forum-dog-small.png" title="Call To Action" text="A description of the CTA" ctaText="Click Me" ctaURL="http://www.bbc.co.uk" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/CTABanner" section="1" --><br />


<hr/>

