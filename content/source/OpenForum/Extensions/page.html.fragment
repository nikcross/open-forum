 <h3> <a href="/OpenForum/Extensions/Table">Table</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/Table" section="1" -->

<p>Creates an editable data table</p>
<b>Parameters</b>
<ul><li> name = Name of the table</li>
<li> actions = Comma-separated list of actions (add, edit, move, remove)</li>
<li> data = Column definitions with format "Label columnName type"</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension Table name="myTable" actions="add,edit,move,remove" data="
Site site
Link url link
" --><table>
<thead>
    <tr>
        <td>Site</td>
        <td>Link</td>
        <td>&nbsp;</td>
   </tr>
</thead>
<tbody>
    <tr of-repeatFor='row in myTable'>
        <td><span style='{{row.view}}'>{{row.site}}</span><span style='{{row.edit}}'><input type='text' value='{{row.site}}' onChange='OpenForum.Table.setCell(myTable,{{row.index}},"site",this.value);'/></span></td>
        <td><span style='{{row.view}}'><a href='{{row.url}}'>{{row.url}}</a></span><span style='{{row.edit}}'><input type='text' value='{{row.url}}' onChange='OpenForum.Table.setCell(myTable,{{row.index}},"url",this.value);'/></span></td>
<td>        <a class='button tiny' onClick='OpenForum.Table.editRow(myTable,{{row.index}}); return false;'>Edit</a>
        <a class='button tiny' onClick='OpenForum.Table.moveRowUp(myTable,{{row.index}}); return false;'>Move Up</a>
        <a class='button tiny' onClick='OpenForum.Table.moveRowDown(myTable,{{row.index}}); return false;'>Move Down</a>
        <a class='button tiny' onClick='OpenForum.Table.removeRow(myTable,{{row.index}}); return false;'>Remove</a>
</td>    </tr>
</tbody>
<tfoot>
<tr><td colspan="6"><a href="#" onClick="OpenForum.Table.addRow(myTable,myTable_rowTemplate); return false;" class="button tiny round">Add Row</a>
</td></tr></tfoot>
</table><script>//=========

myTabletableDefinition = {columns: {
    "tableName": "myTable",
    "rowsDefinition": "\nSite site\nLink url link\n",
    "actions": {
        "add": true,
        "edit": true,
        "move": true,
        "remove": true
    },
    "site": {
        "name": "Site",
        "dataName": "site",
        "type": "text"
    },
    "url": {
        "name": "Link",
        "dataName": "url",
        "type": "link"
    }
},
rows: [
{
    "site": "",
    "url": ""
}
]};

//=========

myTable=[];
myTable_rowTemplate = {"site":"","url":""};
OpenForum.Table.addRow(myTable,myTable_rowTemplate);
//OpenForum.loadJSON("your page/myTable.json",function(json){ myTable=json; });


//=========

</script><!--End Extension Table name="myTable" actions="add,edit,move,remove" data="
Site site
Link url link
" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/Table" section="1" --><br />


