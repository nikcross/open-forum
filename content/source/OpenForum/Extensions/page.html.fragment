 <h3> <a href="/OpenForum/Extensions/Clock">Clock</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/Clock" section="1" -->

<p>Displays a live clock</p>
<b>Parameters</b>
<ul><li> None</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension Clock --><script>
  currentTime = new Date().toLocaleTimeString();
  setInterval(
    function() { currentTime = new Date().toLocaleTimeString(); }
    ,500
  );
</script>
<span class="label tiny success round">{{currentTime}}</span><!--End Extension Clock -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/Clock" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/ContrastBlock">ContrastBlock</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/ContrastBlock" section="1" -->

<p>Creates a colored block with text and optional image</p>
<b>Parameters</b>
<ul><li> text = Text content for the block</li>
<li> backgroundColor = Background color (e.g., "blueviolet")</li>
<li> textColor = Text color (e.g., "white")</li>
<li> imageURL = URL of image to display</li>
<li> imageRight = Position image on right side ("true" or "false")</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension ContrastBlock text="Some text in here" backgroundColor="blueviolet" textColor="white" imageURL="/OpenForum/Images/open-forum-dog.png" imageRight="false" --><div class="row" style="background-color: blueviolet;">
  <div class="columns large-6" style="padding: 0px;">
    <img src="/OpenForum/Images/open-forum-dog.png" />
  </div>
  <div class="columns large-6" style="padding: 0px;">
    <h2 style="color: white; padding: 1em; text-align: center;">Some text in here</h2>
  </div>
</div><!--End Extension ContrastBlock text="Some text in here" backgroundColor="blueviolet" textColor="white" imageURL="/OpenForum/Images/open-forum-dog.png" imageRight="false" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/ContrastBlock" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/CountDown">CountDown</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/CountDown" section="1" -->

<p>Creates a countdown timer that triggers an action</p>
<b>Parameters</b>
<ul><li> counter = Name/label for the counter</li>
<li> action = JavaScript action to call when countdown completes</li>
<li> period = Time period in seconds</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension CountDown counter="Alerts" action="doAction" period="10" -->{{Alerts}}
<script>
var Alerts = 10;
  doAction();
  setInterval(function() {
    Alerts--;
    if(Alerts==0) {
     doAction();
    	Alerts = 10;
    }
  },1000);
</script><!--End Extension CountDown counter="Alerts" action="doAction" period="10" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/CountDown" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/CrumbTrail">CrumbTrail</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/CrumbTrail" section="1" -->

<p>Displays a page hierarchy breadcrumb trail</p>
<b>Parameters</b>
<ul><li> None</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension CrumbTrail --><nav class="breadcrumbs" role="menubar" aria-label="breadcrumbs"><li role="menuitem"><a href="/OpenForum">OpenForum</a></li><li role="menuitem" class="current"><a href="/OpenForum">Extensions</a></li></nav><!--End Extension CrumbTrail -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/CrumbTrail" section="1" --><br />


<hr/>

 <h3> <a href="/OpenForum/Extensions/DataTable">DataTable</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/DataTable" section="1" -->

<p>Creates an interactive data table with actions</p>
<b>Parameters</b>
<ul><li> name = Name of the table (links to Table extension data)</li>
<li> data = Column definitions with format "Label columnName type"</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension DataTable name="myTable" data="
Site site
Open openLink action
" --><div style='padding: 2em;'><div class='dataTable'> <div><table>
<thead>
    <tr>
        <td>Site</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
   </tr>
</thead>
<tbody>
    <tr of-repeatFor='row in myTable'>
        <td><span>{{row.site}}</span></td>
        <td><a class='button tiny round' href='#' onClick='openLink(myTable,{{row.index}}); return false;'>Open</a></td>
    </tr>
</tbody>
<tfoot>
<tr><td colspan="5"></td></tr></tfoot>
</table></div></div></div><script> OpenForum.loadCSS('/OpenForum/Extensions/DataTable/data-table.css');
//=========

myTabletableDefinition = {columns: {
    "tableName": "myTable",
    "rowsDefinition": "\nSite site\nOpen openLink action\n",
    "actions": {},
    "site": {
        "name": "Site",
        "dataName": "site",
        "type": "text"
    },
    "openLink": {
        "name": "Open",
        "dataName": "openLink",
        "type": "action"
    }
},
rows: [
{
    "site": "",
    "openLink": ""
}
]};

//=========

myTable=[];
myTable_rowTemplate = {"site":"","openLink":""};
OpenForum.Table.addRow(myTable,myTable_rowTemplate);
//OpenForum.loadJSON("your page/myTable.json",function(json){ myTable=json; });


//=========

</script><!--End Extension DataTable name="myTable" data="
Site site
Open openLink action
" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/DataTable" section="1" --><br />


