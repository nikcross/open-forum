 <h3> <a href="/OpenForum/Extensions/Form">Form</a> </h3>

 <!--Extension InsertPage page="/OpenForum/Extensions/Form" section="1" -->

<p>Creates a data-entry form with various field types</p>
<b>Parameters</b>
<ul><li> name = Form name identifier</li>
<li> data = Field definitions with format "Label name" or "Type: Label name"</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension Form name="myForm" data="
Name name
Age age

Checkbox: Has Pet hasPet

Table: todo Task task, Description description
" --><form>
  <div class='row'>
    <div class='large-6 columns'>
      <label>Name</label> <input type='text' id='myForm.nameField' of-id='myForm.name' placeholder=' ' />
    </div>
    <div class='large-6 columns'>
      <label>Age</label> <input type='text' id='myForm.ageField' of-id='myForm.age' placeholder=' ' />
    </div>
  </div>
  <div class='row'>
    <div class='large-12 columns'>
      <label>Has Pet</label> <input type='checkbox' id='myForm.hasPetField' of-id='myForm.hasPet' placeholder=' ' />
    </div>
  </div>
<div class='row'><table>
<thead>
    <tr>
        <td>Task</td>
        <td>&nbsp;</td>
   </tr>
</thead>
<tbody>
    <tr of-repeatFor='row in myForm.todo'>
        <td><span style='{{row.view}}'>{{row.task}}</span><span style='{{row.edit}}'><input type='text' value='{{row.task}}' onChange='OpenForum.Table.setCell(myForm.todo,{{row.index}},"task",this.value);'/></span></td>
<td>        <a class='button tiny' onClick='OpenForum.Table.editRow(myForm.todo,{{row.index}}); return false;'>Edit</a>
        <a class='button tiny' onClick='OpenForum.Table.removeRow(myForm.todo,{{row.index}}); return false;'>Remove</a>
</td>    </tr>
</tbody>
<tfoot>
<tr><td colspan="5"><a href="#" onClick="OpenForum.Table.addRow(myForm.todo,myForm.todo_rowTemplate); return false;" class="button tiny round">Add Row</a>
</td></tr></tfoot>
</table></div></form>
<script>myForm = {};myForm.todo=[];
myForm.todo_rowTemplate = {"task":""};
</script><!--End Extension Form name="myForm" data="
Name name
Age age

Checkbox: Has Pet hasPet

Table: todo Task task, Description description
" -->
</xmp>
<!--End Extension InsertPage page="/OpenForum/Extensions/Form" section="1" --><br />


