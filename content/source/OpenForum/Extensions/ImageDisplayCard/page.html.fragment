<!--Content built using /OpenForum/Javascript/PageBuilder/default-page.builder.js 0.0.7 Gloomy November builder and renderer DefaultRenderer v1.08 2021 Covid release-->

<p>Creates an image display card with title, description, and link</p>
<b>Parameters</b>
<ul><li> title = Card title</li>
<li> description = Card description text</li>
<li> linkText = Text for the link button</li>
<li> linkURL = URL for the card link</li>
<li> imageURL = URL of the image to display</li>
</ul>
<xmp class="panel" of-exclude="true">
<!--Extension ImageDisplayCard title="Open Forum" description="Open Forum - The Future" linkText="Open Forum" linkURL="https://open-forum.onestonesoup.org/" imageURL="/OpenForum/Images/open-forum-dog-small.png" --><script>
if( typeof imageDisplayCSSLoaded == "undefined" ){ 
  OpenForum.loadCSS("/OpenForum/Extensions/DisplayCard/page.css");
  imageDisplayCSSLoaded = true;
}
</script>
<div class="medium-4 columns">
  <div class="card">
    <div class="image">
      <img src="/OpenForum/Images/open-forum-dog-small.png">
      <span class="title">Open Forum</span>
    </div>
    <div class="content">
      <p>Open Forum - The Future</p>
    </div>
    <div class="action">
      <a href='https://open-forum.onestonesoup.org/'>Open Forum</a>
    </div>
  </div>
</div><!--End Extension ImageDisplayCard title="Open Forum" description="Open Forum - The Future" linkText="Open Forum" linkURL="https://open-forum.onestonesoup.org/" imageURL="/OpenForum/Images/open-forum-dog-small.png" -->
</xmp>

