<hr/>

Map file.getAttachmentsForPage( {string pageName} )

<b>Example:</b>
<xmp class="panel" of-exclude="true">
var attachments=<a href="/OpenForum/Documentation/OpenForumServerSideJavascript/File/" target="newTab"><img src='/OpenForum/Images/icons/png/link_go.png' /></a>;
var pageName = "/Sandbox";
var matching = ".*"; //Regex include all

var list = file.getAttachmentsForPage( pageName );
if(pageName.charAt(0)!='/')
{
  pageName = "/"+pageName;
}

var iterator= list.keySet().iterator();
while(iterator.hasNext())
{
  var key = ""+iterator.next();
  var item;
  if(key.charAt(0)==='+') { // ignore sub pages
    continue;
  } else if(matching!==null && key.search( ""+matching )==-1 ) {
    continue;
  } else {
    item = key;
  }

  attachments.push( {pageName: pageName, fileName: item} );

}
</xmp><!--OF insert (/OpenForum/Documentation/OpenForumServerSideJavascript/file.page.content) end -->
