 <h3>ScriptClip</h3>
 <!--Extension InsertPage page="/OpenForum/Extensions/ScriptClip" section="1" -->

<p>Displays a small line of text on the page with a button to transfer it to the clipboard</p>
<b>Parameters</b>
<ul><li> script = The text to display </li>
<li> fileName = Alternative to script - the file to display as a clip</li>
          
<xmp class="panel" of-exclude="true">
<!--Extension ScriptClip script="ls -la /open-forum/content" --><div class='row'><div class='columns large-10'><textarea style='border: none; background-color: black; color: lightgreen; font-family: monospace;'  id='D837B35B' rows='2' >ls -la /open-forum/content</textarea></div><div class='columns large-2'><a href='#' title='Copy to clipboard' onClick='OpenForum.copyElement("D837B35B"); return false;'><img src='/OpenForum/Images/icons/png/page_copy.png' /></a></div></div><script>document.getElementById('D837B35B').setAttribute('readonly', 'readonly');</script><!--End Extension ScriptClip script="ls -la /open-forum/content" -->
</xmp>
</ul><!--End Extension InsertPage page="/OpenForum/Extensions/ScriptClip" section="1" --> 
