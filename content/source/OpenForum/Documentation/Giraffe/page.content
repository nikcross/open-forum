      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/rectangle');">Rectangle</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/line');">Line</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/text');">Text</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/polygon');">Polygon</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/picture');">Picture</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/line-style');">Line Style</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/text-width');">Text Width</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/gradient-color');">Color Gradient</a></li>
      <li><a href="[{Hash}]" onclick="return loadExample('Giraffe/examples/radial-color');">Radial Color</a></li>
