<li> Set up queue polling</li>
<xmp class="panel" of-exclude="true">
var queueName = "my-queue-name";
var queue;

OpenForum.init = function() {
  queue = new MessageQueue(queueName);

  timer = setInterval( queue.pull , 1000 );
};
